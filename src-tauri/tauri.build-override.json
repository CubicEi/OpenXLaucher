{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenXLauncher",
  "identifier": "com.openxlauncher.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:51515",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "OpenXLauncher",
        "width": 1024,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game"
  },
  "plugins": {}
}